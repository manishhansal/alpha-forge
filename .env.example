# Copy this file to .env.local and fill in. The defaults below match docker-compose.yml.

# --- Public (browser-exposed) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- data-service2.0 connection ---
# Base URL of the data-service2.0 instance (Docker: http://data-service:8200)
DATA_SERVICE_2_URL=http://localhost:8200
# API key for authenticating with data-service2.0 (REST + server-side WebSocket).
# Obtain from data-service2.0 administrator
DATA_SERVICE_API_KEY=
# Browser-exposed counterparts — required so the Next.js client can open
# authenticated WebSocket connections to /v1/stream/ticks.
# These must match the server-side values above.
NEXT_PUBLIC_DATA_SERVICE_URL=http://localhost:8200
NEXT_PUBLIC_DATA_SERVICE_API_KEY=

# --- Database (Postgres via docker-compose) ---
# docker-compose maps Postgres to host port 5433 (5432 is often taken by a
# native install). User/pass/db match docker-compose.yml.
DATABASE_URL=postgresql://crypto:crypto@localhost:5433/crypto_dashboard

# --- Cache (Redis via docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- Optional 3rd-party APIs ---
COINGECKO_API_KEY=
COINGLASS_API_KEY=

# --- Execution Brokers (optional) ---
# These credentials are for ORDER EXECUTION only — NOT for market data.
# Market data is served exclusively by data-service2.0.
#
# Upstox OAuth credentials — required only if you use Upstox for live order routing.
# Register an app at https://developer.upstox.com/ to obtain client credentials.
# ALL of these are SERVER-SIDE ONLY — never exposed to the browser.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# --- Broker selection (execution) ---
# Which execution broker the dashboard routes orders to.
# Allowed: `delta` (default) or `binance`.
ACTIVE_BROKER=delta
# Override for Delta REST base — point to testnet by setting
# `https://cdn-ind.testnet.deltaex.org` if needed.
DELTA_REST_BASE_URL=https://api.india.delta.exchange

# --- Auth.js v5 ---
# Generate with: `npx auth secret` (or `openssl rand -hex 32`). 32+ chars required.
AUTH_SECRET=
# Set to "true" when running behind a reverse proxy (e.g. Vercel, Fly, Railway).
AUTH_TRUST_HOST=true

# --- Sensitive-field encryption (AES-256-GCM) ---
# 64 hex chars (= 32 bytes). Generate with: `openssl rand -hex 32`.
# Required only when a user saves exchange API keys in Settings.
ENCRYPTION_KEY=

# --- Alert delivery channels (optional) ---
# Resend API key for email alerts. https://resend.com
RESEND_API_KEY=
ALERT_EMAIL_FROM="Alphaforge <alerts@example.com>"
# Signing secret for outbound webhooks (used in X-Crypto-Desk-Signature header).
# Generate with: `openssl rand -hex 24`.
ALERT_WEBHOOK_SIGNING_SECRET=

# --- Worker tuning (all optional, sensible defaults baked in) ---
# Comma-separated Binance futures symbols to track for liquidations.
# Default: BTCUSDT,ETHUSDT,SOLUSDT
WORKER_LIQUIDATION_SYMBOLS=
WORKER_SIGNAL_INGEST_INTERVAL_MS=60000
WORKER_SIGNAL_OUTCOME_INTERVAL_MS=300000
WORKER_ALERTS_INTERVAL_MS=30000
# Base URL the worker hits to drive `/api/signals` (defaults to NEXT_PUBLIC_APP_URL).
WORKER_APP_BASE_URL=http://localhost:3000

# --- Worker logging ---
# Log threshold. Defaults: info in production, debug otherwise.
WORKER_LOG_LEVEL=
# Output format: `pretty` (default in dev) or `json` (default in prod). JSON is
# one structured record per line, ready to ship to Datadog / Loki / CloudWatch.
WORKER_LOG_FORMAT=
# Service tag used in JSON logs and Sentry events. Defaults to `crypto-desk-worker`.
WORKER_SERVICE_NAME=

# --- Sentry (optional; worker only) ---
# When unset, every Sentry call in the worker is a no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 0..1; tracing has CPU cost — leave at 0 unless you specifically want it.
SENTRY_TRACES_SAMPLE_RATE=0

# --- ML Service (Python multi-model AI decision engine) ---
# URL of the FastAPI ML service. Runs alongside the Next.js app on port 8100.
# When unset or unreachable, the India AI engine falls back to its rule-based
# heuristic scoring (zero degradation in signal quality, just no ML enhancement).
ML_SERVICE_URL=http://localhost:8100

# --- WhatsApp Notifications (Evolution-Go self-hosted gateway) ---
# Base URL of your Evolution-Go instance (e.g. http://localhost:8080 or a remote URL).
# When unset, all WhatsApp dispatch is silently skipped — no errors are thrown.
WHATSAPP_EVOLUTION_API_URL=
# Evolution-Go session/instance name representing an authenticated WhatsApp connection.
# When unset, all WhatsApp dispatch is silently skipped — no errors are thrown.
WHATSAPP_INSTANCE=
# API authentication key for your Evolution-Go instance (used in the `apikey` header).
# Optional: some self-hosted Evolution instances run without authentication.
WHATSAPP_API_KEY=
