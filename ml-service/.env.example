# ML Service Configuration
ML_SERVICE_PORT=8100
ML_LOG_LEVEL=INFO

# Model artifacts path (mounted volume in production)
MODEL_ARTIFACTS_PATH=/app/artifacts

# Feature cache TTL (seconds)
FEATURE_CACHE_TTL=60

# ─── AlphaForge Normalized Indian Market Data Layer ──────────────────────────
#
# Primary source for the ML training pipeline.  The Next.js app normalises data
# from Angel One SmartAPI (primary) and Upstox Analytics (failover) before
# serving it at the endpoints below.
#
# ALPHAFORGE_API_BASE_URL
#   Base URL for the AlphaForge Next.js API layer.
#   The training pipeline fetches OHLCV, option-chain history, market-breadth,
#   and India VIX from sub-paths of this URL.
#   Defaults to NEXTJS_API_BASE_URL when unset.
#   Example (local dev):  http://localhost:3000/api/in
#   Example (production): https://app.alphaforge.in/api/in
ALPHAFORGE_API_BASE_URL=http://localhost:3000/api/in

# DATABASE_URL
#   PostgreSQL connection string for the secondary data source.
#   When set, the pipeline can query stored OptionChainSnapshot records and
#   price_history directly from the database — useful for offline training runs
#   or when the API layer is unreachable.
#   Leave blank to skip the PostgreSQL tier entirely.
#   Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://crypto:crypto@localhost:5433/crypto_dashboard

# ML_DATA_REQUEST_DELAY
#   Seconds to sleep between consecutive symbol requests (float).
#   Prevents rate-limit errors from Angel One / Upstox APIs.
#   Default: 0.2  (200 ms — well inside Angel One's 3 req/s limit)
ML_DATA_REQUEST_DELAY=0.2

# ─── Legacy / fallback data source ───────────────────────────────────────────
#
# NEXTJS_API_BASE_URL is the historic env var used by the live inference server.
# The training pipeline reads ALPHAFORGE_API_BASE_URL first and falls back to
# NEXTJS_API_BASE_URL when the former is unset — no breakage for existing deploys.
NEXTJS_API_BASE_URL=http://localhost:3000/api/in

# ─── Training configuration ───────────────────────────────────────────────────
TRAINING_DATA_PATH=/app/data
OPTUNA_STUDY_NAME=alphaforge-hpo
