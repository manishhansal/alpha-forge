{
  "artifact": "phase-3m-shadow-schema",
  "description": "Shadow/paper execution contract (spec \u00a710\u201313). NEVER a broker.",
  "guarantees": {
    "broker_execution": false,
    "corrections_are_new_events": true,
    "idempotent_per_decision": true,
    "immutable_append_only": true,
    "live_forbidden": true,
    "reuses_phase3g_simulator": true,
    "second_simulator": false
  },
  "ledger_event_types": [
    "ORDER_CREATED",
    "FILL_CREATED",
    "ORDER_COMPLETED",
    "ORDER_CANCELLED",
    "CORRECTION"
  ],
  "shadow_fill_fields": {
