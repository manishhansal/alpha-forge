    },
    "data_snapshot_id": {
      "required": false,
      "type": "str"
    },
    "decision_id": {
      "required": true,
      "type": "str"
    },
    "execution_policy": {
      "required": false,
      "type": "str"
    },
    "execution_policy_version": {
      "required": false,
      "type": "str"
    },
    "feature_version": {
      "required": false,
      "type": "str"
    },
    "fees": {
      "required": false,
      "type": "float"
    },
    "fill_id": {
      "required": true,
      "type": "str"
    },
    "fill_timestamp": {
      "required": false,
      "type": "str"
    },
    "instrument": {
      "required": true,
      "type": "str"
    },
    "market_regime": {
      "required": false,
      "type": "Optional[str]"
    },
    "model_ids": {
      "required": false,
      "type": "list[str]"
    },
    "order_id": {
      "required": true,
      "type": "str"
    },
    "pnl_reconciled": {
      "required": false,
      "type": "bool"
    },
    "quantity_filled": {
      "required": true,
      "type": "float"
    },
    "realized_pnl": {
      "required": false,
      "type": "float"
    },
    "rl_action": {
      "required": false,
      "type": "str"
