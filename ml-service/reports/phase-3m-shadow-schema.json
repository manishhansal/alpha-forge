    },
    "model_ids": {
      "required": false,
      "type": "list[str]"
    },
    "order_id": {
      "required": true,
      "type": "str"
    },
    "order_timestamp": {
      "required": true,
      "type": "str"
    },
    "quantity": {
      "required": true,
